# The API connects as the limited app role (create the roles with database/roles.sql or ./database/setup-dev.sh).
# Never put the PostgreSQL superuser here: it could edit the audit log.
DATABASE_URL="postgresql://medicore_app:replace-with-the-app-role-password@localhost:5432/smart_hospital?schema=public"
# Development/test only (npm run db:seed): the seeder role. Do not set this in production.
# SEED_DATABASE_URL="postgresql://medicore_seeder:replace-with-the-seeder-role-password@localhost:5432/smart_hospital?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
JWT_EXPIRES_IN="1d"
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=10
# Per-account login throttling: lock an email for LOGIN_LOCK_MINUTES after LOGIN_MAX_FAILURES failed logins
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# API documentation (Swagger UI at /api/docs, OpenAPI document at /api/openapi.json): always on outside production;
# in production it is OFF unless you set API_DOCS=true (it lists every endpoint and role, but holds no secrets or patient data).
# API_DOCS=true
