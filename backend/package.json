    "test:security": "node tests/security.test.js",
    "test:architecture": "node tests/architecture.test.js",
    "test:analytics": "node tests/analytics.test.js",
    "test:escalation": "node tests/escalation.test.js",
    "test:access": "node tests/access.test.js",
    "test:privacy": "node tests/privacy.test.js",
    "test:softdelete": "node tests/softdelete.test.js",
    "test:audit": "node tests/audit-protection.test.js",
    "test:contract": "node tests/api-contract.test.js",
    "routes": "node scripts/list-api-routes.js --write",
    "openapi": "node scripts/build-openapi.js --write",
